---
/**
 * Base.astro — Root layout wrapping every page.
 * Provides: <head>, Nav, Footer, Emblem, Lucide icon init.
 * Props:
 *   title: string — <title> tag content
 *   description: string — <meta name="description"> content
 *   activePage: string — passed to Nav for active link highlighting
 *   footerVariant: "full" | "minimal" — passed to Footer
 */
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import Emblem from "../components/Emblem.astro";
import "../styles/style.css";

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  footerVariant?: "full" | "minimal";
}

const {
  title,
  description = "Colegio Pastoral Ortodoxo San Basilio — Diócesis de México, OCA",
  activePage = "",
  footerVariant = "full",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, "https://colegiopastoralortodoxosanbasilio.com.mx").href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content="https://colegiopastoralortodoxosanbasilio.com.mx/assets/img/logo.png" />
    <meta property="og:site_name" content="Colegio Pastoral Ortodoxo San Basilio" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://colegiopastoralortodoxosanbasilio.com.mx/assets/img/logo.png" />

    <!-- Structured Data (JSON-LD) for Google Search Console (Admissions contact) -->
    {activePage === "inicio" && (
      <script type="application/ld+json" is:inline set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "EducationalOrganization",
        "name": "Colegio Pastoral Ortodoxo San Basilio",
        "description": "Seminario e institución de formación teológica, litúrgica y pastoral de la Diócesis de México de la Iglesia Ortodoxa en América (OCA).",
        "url": "https://colegiopastoralortodoxosanbasilio.com.mx",
        "logo": "https://colegiopastoralortodoxosanbasilio.com.mx/assets/img/logo.png",
        "image": "https://colegiopastoralortodoxosanbasilio.com.mx/assets/img/logo.png",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Ciudad de México",
          "addressCountry": "MX"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+52-55-7903-1388",
            "contactType": "Admissions",
            "email": "cposb.oca@gmail.com",
            "availableLanguage": "Spanish"
          }
        ],
        "sameAs": [
          "https://www.youtube.com/playlist?list=PL42TqdUSrImrQ2jUieADSn6V-sKUJuZAB"
        ]
      })} />
    )}

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Sorts+Mill+Goudy:ital@0;1&display=swap"
      rel="stylesheet"
    />

    <!-- Icons -->
    <script src="https://unpkg.com/lucide@latest" is:inline></script>

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/assets/img/logo.png" />

    <!-- Supabase config (for client-side auth) -->
    <meta name="supabase-url" content={import.meta.env.PUBLIC_SUPABASE_URL || ""} />
    <meta name="supabase-anon-key" content={import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ""} />
  </head>
  <body>
    <Nav activePage={activePage} />

    <slot />

    <Emblem />
    <Footer variant={footerVariant} />

    <script is:inline>lucide.createIcons();</script>
    <script is:inline>
      (function () {
        const hash = window.location.hash || "";
        const hasIdentityToken =
          hash.includes("invite_token=") ||
          hash.includes("confirmation_token=") ||
          hash.includes("recovery_token=");

        if (hasIdentityToken && !window.location.pathname.startsWith("/admin/")) {
          window.location.replace(`/admin/${hash}`);
        }
      })();
    </script>
  </body>
</html>
