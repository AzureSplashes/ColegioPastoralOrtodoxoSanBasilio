---
export const prerender = false;
import Portal from "../../../layouts/Portal.astro";
import { createClient } from "../../../lib/supabase";
const supabase = createClient(Astro.cookies, Astro.request.headers.get("cookie"));
const user = Astro.locals.user;
const canManage = Astro.locals.role === "profesor" || Astro.locals.role === "admin";
let formError = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") || "create");
  if (action === "delete") {
    const id = String(form.get("id") || "");
    if (!canManage || !/^[0-9a-f-]{36}$/i.test(id)) formError = "No tienes permiso para eliminar esta conversación.";
    else {
      const { error } = await supabase.from("forum_threads").delete().eq("id", id);
      if (error) formError = "No se pudo eliminar la conversación.";
      else return Astro.redirect("/alumnos/foros/", 303);
    }
  } else if (action === "create") {
  const title = String(form.get("title") || "").trim();
  const body = String(form.get("body") || "").trim();
  if (title.length < 5 || title.length > 160 || body.length < 10 || body.length > 5000) {
    formError = "El título debe tener entre 5 y 160 caracteres y el mensaje entre 10 y 5000.";
  } else if (!user) {
    formError = "Tu sesión ha terminado. Vuelve a entrar.";
  } else {
    const { data, error } = await supabase.from("forum_threads").insert({ title, body, author_id: user.id }).select("id").single();
    if (error || !data) formError = "No se pudo guardar la conversación. Inténtalo de nuevo.";
    else return Astro.redirect(`/alumnos/foros/${data.id}/`, 303);
  }
  } else formError = "Acción no válida.";
}
const { data: threads, error: loadError } = await supabase.from("forum_threads").select("id,title,body,author_id,created_at").order("created_at", { ascending: false }).limit(100);
const authorIds = [...new Set((threads || []).map((thread) => thread.author_id))];
const { data: authors } = authorIds.length ? await supabase.from("profiles").select("id,display_name").in("id", authorIds) : { data: [] };
const authorNames = new Map((authors || []).map((author) => [author.id, author.display_name]));
---
<Portal title="Foros | Portal académico" portalPage="foros">
  <main class="section"><div class="container"><div class="section-header"><h1 class="section-title">Foros</h1><p>Comparte preguntas, lecturas e ideas con la comunidad académica.</p></div>
    <div class="forum-layout"><section class="forum-list"><h2>Conversaciones recientes</h2>
      {loadError ? <p class="portal-notice">El foro aún no está configurado en Supabase.</p> : threads?.length ? threads.map((thread) => <div class="forum-thread"><a href={`/alumnos/foros/${thread.id}/`}><span class="forum-date">{new Date(thread.created_at).toLocaleDateString("es-MX", {day:"numeric",month:"short",year:"numeric"})} · {authorNames.get(thread.author_id) || (thread.author_id === user?.id ? "Tú" : "Miembro del Colegio")}</span><h3>{thread.title}</h3><p>{thread.body.length > 180 ? `${thread.body.slice(0,180)}…` : thread.body}</p><span class="forum-read">Leer conversación →</span></a>{canManage && <form method="post" onsubmit="return confirm('¿Eliminar esta conversación y todas sus respuestas?')"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={thread.id} /><button class="mod-delete" type="submit">Eliminar conversación</button></form>}</div>) : <p class="portal-notice">Aún no hay conversaciones. Puedes iniciar la primera.</p>}
    </section><aside class="forum-compose"><span class="forum-kicker">PARTICIPA</span><h2>Nueva conversación</h2><p>Escribe un tema claro para facilitar las respuestas.</p>
      {formError && <p class="forum-error" role="alert">{formError}</p>}
      <form method="post"><input type="hidden" name="action" value="create" /><label for="thread-title">Título</label><input id="thread-title" name="title" required minlength="5" maxlength="160" placeholder="¿Sobre qué quieres conversar?" /><label for="thread-body">Mensaje</label><textarea id="thread-body" name="body" required minlength="10" maxlength="5000" rows="7" placeholder="Comparte tu pregunta o reflexión..."></textarea><button class="btn btn-primary" type="submit">Publicar discusión</button></form>
    </aside></div>
  </div></main>
</Portal>
<style>.forum-layout{display:grid;grid-template-columns:minmax(0,1.4fr) minmax(280px,.8fr);gap:2rem;align-items:start}.forum-list>h2,.forum-compose h2{font-size:2rem;margin-bottom:1rem}.forum-thread{display:block;background:#fff;border:1px solid #ded7c9;padding:1.3rem;margin-bottom:.75rem}.forum-thread:hover{border-color:#b59555}.forum-date,.forum-kicker{font-size:.7rem;font-weight:700;letter-spacing:.1em;color:#8d7444;text-transform:uppercase}.forum-thread h3{font-size:1.45rem;margin:.4rem 0}.forum-thread p,.forum-compose p{color:var(--color-text-light);font-size:.9rem;line-height:1.55}.forum-read{display:block;color:var(--color-primary);font-weight:700;font-size:.78rem;margin-top:1rem}.forum-compose{background:#eeeae1;padding:1.5rem;border-top:3px solid #b59555}.forum-compose form{display:grid;gap:.55rem;margin-top:1.2rem}.forum-compose label{font-weight:700;font-size:.8rem;margin-top:.4rem}.forum-compose input,.forum-compose textarea{width:100%;padding:.75rem;border:1px solid #cfc5b5;background:#fff;font:inherit}.forum-compose button{margin-top:.8rem;justify-content:center}.portal-notice{padding:1.3rem;background:#fff;border:1px solid #ded7c9;color:var(--color-text-light)}.forum-error{color:#8f2d2d!important;font-weight:700}@media(max-width:900px){.forum-layout{grid-template-columns:1fr}}</style>
<style>.mod-delete{margin-top:.8rem;background:none;border:0;padding:0;color:#8f2d2d;font:700 .8rem var(--font-body);cursor:pointer;text-decoration:underline}</style>
