---
export const prerender = false;
import Portal from "../../../layouts/Portal.astro";
import { createClient } from "../../../lib/supabase";
const supabase = createClient(Astro.cookies, Astro.request.headers.get("cookie"));
const user = Astro.locals.user;
const canManage = Astro.locals.role === "profesor" || Astro.locals.role === "admin";
const id = Astro.params.id || "";
let formError = "";
if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") || "reply");
  if (action === "delete_post") {
    const postId = String(form.get("post_id") || "");
    if (!canManage || !/^[0-9a-f-]{36}$/i.test(postId)) formError = "No tienes permiso para eliminar esta respuesta.";
    else {
      const { error } = await supabase.from("forum_posts").delete().eq("id", postId).eq("thread_id", id);
      if (error) formError = "No se pudo eliminar la respuesta.";
      else return Astro.redirect(`/alumnos/foros/${id}/`, 303);
    }
  } else if (action === "reply") {
  const body = String(form.get("body") || "").trim();
  if (body.length < 2 || body.length > 5000) formError = "La respuesta debe tener entre 2 y 5000 caracteres.";
  else if (!user) formError = "Tu sesión ha terminado. Vuelve a entrar.";
  else {
    const { error } = await supabase.from("forum_posts").insert({ thread_id: id, author_id: user.id, body });
    if (error) formError = "No se pudo guardar tu respuesta. Inténtalo de nuevo.";
    else return Astro.redirect(`/alumnos/foros/${id}/`, 303);
  }
  } else formError = "Acción no válida.";
}
const { data: thread } = await supabase.from("forum_threads").select("id,title,body,author_id,created_at").eq("id",id).maybeSingle();
if (!thread) Astro.response.status = 404;
const { data: posts } = thread ? await supabase.from("forum_posts").select("id,body,author_id,created_at").eq("thread_id",id).order("created_at",{ascending:true}).limit(200) : { data: [] };
---
<Portal title={`${thread?.title || "Conversación"} | Foros`} portalPage="foros"><main class="section"><div class="container"><a href="/alumnos/foros/" class="back-link">← Volver a los foros</a>
  {thread ? <><div class="forum-topic"><span>{new Date(thread.created_at).toLocaleDateString("es-MX",{day:"numeric",month:"long",year:"numeric"})} · {thread.author_id === user?.id ? "Tú" : "Miembro del Colegio"}</span><h1>{thread.title}</h1><p>{thread.body}</p></div><h2 class="reply-heading">Respuestas ({posts?.length || 0})</h2>{formError && <p class="forum-error" role="alert">{formError}</p>}{posts?.length ? posts.map((post) => <article class="forum-reply"><div>{post.author_id === user?.id ? "Tú" : "Miembro del Colegio"}<time>{new Date(post.created_at).toLocaleDateString("es-MX",{day:"numeric",month:"short",year:"numeric"})}</time></div><p>{post.body}</p>{canManage && <form method="post" onsubmit="return confirm('¿Eliminar esta respuesta?')"><input type="hidden" name="action" value="delete_post" /><input type="hidden" name="post_id" value={post.id} /><button class="mod-delete" type="submit">Eliminar respuesta</button></form>}</article>) : <p class="reply-empty">Todavía no hay respuestas.</p>}
  <section class="reply-form"><h2>Responder</h2><form method="post"><input type="hidden" name="action" value="reply" /><label for="reply-body">Tu respuesta</label><textarea id="reply-body" name="body" required minlength="2" maxlength="5000" rows="5"></textarea><button type="submit" class="btn btn-primary">Publicar respuesta</button></form></section></> : <p>Esta conversación no existe o no está disponible.</p>}
</div></main></Portal>
<style>.back-link{color:#745b30;font-weight:700;font-size:.85rem}.forum-topic{padding:2rem;background:#fff;border-top:4px solid #b59555;margin:1.5rem 0 2rem}.forum-topic span{color:#8d7444;font-size:.75rem;font-weight:700;text-transform:uppercase}.forum-topic h1{font-size:clamp(2rem,4vw,3.5rem);margin:.6rem 0 1rem}.forum-topic p,.forum-reply p{white-space:pre-wrap;line-height:1.7}.reply-heading,.reply-form h2{font-size:2rem;margin-bottom:1rem}.forum-reply{padding:1.3rem;background:#fff;border:1px solid #ded7c9;margin-bottom:.7rem}.forum-reply>div{font-size:.8rem;font-weight:700;color:#755d36;margin-bottom:.7rem}.forum-reply time{float:right;color:var(--color-text-light);font-weight:400}.reply-empty{color:var(--color-text-light)}.reply-form{margin-top:2.5rem;background:#eeeae1;padding:1.5rem}.reply-form form{display:grid;gap:.7rem}.reply-form label{font-size:.8rem;font-weight:700}.reply-form textarea{font:inherit;padding:.8rem;border:1px solid #cfc5b5}.reply-form button{justify-self:start}.forum-error{color:#8f2d2d;font-weight:700}</style>
<style>.mod-delete{margin-top:.8rem;background:none;border:0;padding:0;color:#8f2d2d;font:700 .8rem var(--font-body);cursor:pointer;text-decoration:underline}</style>
