---
export const prerender = false;
import Portal from "../../../layouts/Portal.astro";
import { createClient } from "../../../lib/supabase";
const supabase = createClient(Astro.cookies, Astro.request.headers.get("cookie"));
const role = (Astro.locals.role as string | null) || "alumno";
const user = Astro.locals.user;
const canManage = role === "profesor" || role === "admin";
let formError = "";
if (Astro.request.method === "POST" && canManage) {
  const form = await Astro.request.formData();
  const action = String(form.get("action") || "create");
  if (action === "delete") {
    const id = String(form.get("id") || "");
    if (!/^[0-9a-f-]{36}$/i.test(id)) formError = "Calificación no válida.";
    else {
      const { error } = await supabase.from("portal_grades").delete().eq("id", id);
      if (error) formError = "No se pudo eliminar la calificación.";
      else return Astro.redirect("/alumnos/boleta/", 303);
    }
  } else if (action === "create" || action === "update") {
  const id = String(form.get("id") || "");
  const studentId = String(form.get("student_id") || "");
  const course = String(form.get("course") || "").trim();
  const assessment = String(form.get("assessment") || "").trim();
  const term = String(form.get("term") || "").trim();
  const score = Number(form.get("score"));
  const maxScore = Number(form.get("max_score"));
  if ((action === "update" && !/^[0-9a-f-]{36}$/i.test(id)) || !/^[0-9a-f]{8}-[0-9a-f-]{27,}$/i.test(studentId) || !course || !assessment || course.length > 120 || assessment.length > 120 || term.length > 80 || !Number.isFinite(score) || !Number.isFinite(maxScore) || score < 0 || maxScore <= 0 || score > maxScore) {
    formError = "Revisa el alumno, la evaluación y la calificación.";
  } else {
    const values = { student_id: studentId, course, assessment, term: term || null, score, max_score: maxScore };
    const { error: saveError } = action === "update" ? await supabase.from("portal_grades").update(values).eq("id", id) : await supabase.from("portal_grades").insert(values);
    if (saveError) formError = "No se pudo guardar la calificación.";
    else return Astro.redirect("/alumnos/boleta/", 303);
  }
  } else formError = "Acción no válida.";
}
const { data: students } = canManage ? await supabase.from("profiles").select("id,role,display_name").eq("role","alumno").order("display_name") : { data: [] };
const query = supabase.from("portal_grades").select("id,student_id,course,assessment,score,max_score,term,created_at").order("course").order("assessment");
const { data: grades, error } = await (canManage ? query : query.eq("student_id", user?.id || ""));
const studentNames = new Map((students || []).map((student) => [student.id, student.display_name || student.id.slice(0,8)]));
---
<Portal title="Boleta | Portal académico" portalPage="boleta"><main class="section"><div class="container"><div class="section-header"><h1 class="section-title">Boleta</h1><p>{canManage ? "Calificaciones publicadas para los estudiantes." : "Consulta las calificaciones que el Colegio ha publicado para ti."}</p></div>
  {canManage && !error && <section class="grade-entry"><h2>Publicar calificación</h2>{formError && <p role="alert" class="grade-error">{formError}</p>}{students?.length ? <form method="post"><input type="hidden" name="action" value="create" /><label for="grade-student">Alumno</label><select id="grade-student" name="student_id" required><option value="">Selecciona un alumno</option>{students.map((student) => <option value={student.id}>{student.display_name || student.id.slice(0,8)}</option>)}</select><label for="grade-course">Asignatura</label><input id="grade-course" name="course" required maxlength="120" /><label for="grade-assessment">Evaluación</label><input id="grade-assessment" name="assessment" required maxlength="120" /><label for="grade-term">Periodo</label><input id="grade-term" name="term" maxlength="80" /><div class="grade-numbers"><div><label for="grade-score">Calificación</label><input id="grade-score" name="score" type="number" min="0" step="0.01" required /></div><div><label for="grade-max">De un máximo de</label><input id="grade-max" name="max_score" type="number" min="0.01" step="0.01" value="10" required /></div></div><button class="btn btn-primary" type="submit">Guardar calificación</button></form> : <p>Para publicar calificaciones, primero agrega alumnos con rol <code>alumno</code> en Supabase.</p>}</section>}
  {error ? <div class="grade-empty">La boleta aún no está configurada en Supabase.</div> : grades?.length ? <div class="grade-table-wrap"><table><thead><tr>{canManage && <th>Alumno</th>}<th>Asignatura</th><th>Evaluación</th><th>Periodo</th><th>Calificación</th>{canManage && <th>Gestión</th>}</tr></thead><tbody>{grades.map((grade) => <tr>{canManage && <td>{studentNames.get(grade.student_id) || `${grade.student_id.slice(0,8)}…`}</td>}<td><strong>{grade.course}</strong></td><td>{grade.assessment}</td><td>{grade.term || "—"}</td><td class="score">{grade.score} / {grade.max_score}</td>{canManage && <td><details><summary>Editar</summary><form method="post" class="grade-edit"><input type="hidden" name="action" value="update" /><input type="hidden" name="id" value={grade.id} /><label>Alumno<select name="student_id" required>{students?.map((student) => <option value={student.id} selected={student.id === grade.student_id}>{student.display_name || student.id.slice(0,8)}</option>)}</select></label><label>Asignatura<input name="course" value={grade.course} required maxlength="120" /></label><label>Evaluación<input name="assessment" value={grade.assessment} required maxlength="120" /></label><label>Periodo<input name="term" value={grade.term || ""} maxlength="80" /></label><label>Calificación<input name="score" type="number" min="0" step="0.01" value={grade.score} required /></label><label>Máximo<input name="max_score" type="number" min="0.01" step="0.01" value={grade.max_score} required /></label><button type="submit">Guardar cambios</button></form></details><form method="post" onsubmit="return confirm('¿Eliminar esta calificación?')"><input type="hidden" name="action" value="delete" /><input type="hidden" name="id" value={grade.id} /><button class="grade-delete" type="submit">Eliminar</button></form></td>}</tr>)}</tbody></table></div> : <div class="grade-empty"><i data-lucide="graduation-cap"></i><h2>Aún no hay calificaciones publicadas</h2><p>Cuando el Colegio publique una evaluación, aparecerá aquí.</p></div>}
</div></main></Portal>
<style>.grade-entry{background:#eeeae1;border-top:3px solid #b59555;padding:1.5rem;margin-bottom:2rem}.grade-entry h2{font-size:1.9rem;margin-bottom:1rem}.grade-entry form{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.5rem 1rem;max-width:800px}.grade-entry label{font-size:.78rem;font-weight:700;margin-top:.6rem}.grade-entry input,.grade-entry select{width:100%;padding:.75rem;border:1px solid #cfc5b5;font:inherit;background:#fff}.grade-entry form>label,.grade-entry form>input,.grade-entry form>select,.grade-numbers,.grade-entry button{grid-column:1/-1}.grade-numbers{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.grade-numbers label{display:block}.grade-entry button{justify-self:start;margin-top:.8rem}.grade-error{color:#8f2d2d;font-weight:700}.grade-table-wrap{overflow-x:auto;background:#fff;border:1px solid #ded7c9}table{border-collapse:collapse;width:100%;min-width:600px}th{text-align:left;background:#eee9dd;color:#514657;font-size:.76rem;letter-spacing:.08em;text-transform:uppercase}th,td{padding:1rem;border-bottom:1px solid #e3ddd3}td{font-size:.9rem}td strong{color:var(--color-primary)}.score{font-weight:700;color:#4c365f}.grade-empty{background:#fff;border:1px solid #ded7c9;padding:3rem 2rem;text-align:center;color:var(--color-text-light)}.grade-empty svg{width:40px;height:40px;color:#b59555;margin:0 auto 1rem}.grade-empty h2{font-size:1.8rem;margin-bottom:.5rem}</style>
<style>.grade-edit{display:grid;gap:.4rem;min-width:230px;padding:.8rem 0}.grade-edit label{display:grid;gap:.2rem;font-size:.75rem;font-weight:700}.grade-edit input,.grade-edit select{width:100%;padding:.4rem;border:1px solid #cfc5b5;font:inherit}.grade-edit button{background:var(--color-primary);color:#fff;border:0;padding:.5rem;cursor:pointer}.grade-delete{margin-top:.6rem;background:none;border:0;padding:0;color:#8f2d2d;font:700 .8rem var(--font-body);cursor:pointer;text-decoration:underline}summary{cursor:pointer;color:var(--color-primary);font-weight:700}</style>
