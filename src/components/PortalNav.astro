---
interface Props { activePage?: string; role?: string | null; }
const { activePage = "", role = null } = Astro.props;
const items = [
  { href: "/alumnos/panel/", label: "Panel", slug: "panel", icon: "layout-dashboard" },
  { href: "/alumnos/en-vivo/", label: "Clases en vivo", slug: "en-vivo", icon: "video" },
  { href: "/alumnos/clases/", label: "Clases pregrabadas", slug: "clases", icon: "play-circle" },
  { href: "/alumnos/comunicados/", label: "Comunicados", slug: "comunicados", icon: "megaphone" },
  { href: "/alumnos/foros/", label: "Foros", slug: "foros", icon: "messages-square" },
  { href: "/alumnos/tareas/", label: "Tareas", slug: "tareas", icon: "clipboard-list" },
  { href: "/alumnos/recursos/", label: "Recursos", slug: "recursos", icon: "folder-open" },
  { href: "/alumnos/boleta/", label: "Boleta", slug: "boleta", icon: "graduation-cap" },
];
---
<aside class="portal-sidebar" aria-label="Navegación del portal">
  <div class="portal-sidebar-heading">
    <span class="portal-eyebrow">COLEGIO SAN BASILIO</span>
    <strong>Portal académico</strong>
    <small>{role === "profesor" ? "Espacio para profesores" : role === "admin" ? "Administración académica" : "Espacio para alumnos"}</small>
  </div>
  <nav class="portal-menu" aria-label="Secciones académicas">
    {items.map((item) => <a href={item.href} class:list={["portal-menu-link", { active: activePage === item.slug }]} aria-current={activePage === item.slug ? "page" : undefined}><i data-lucide={item.icon}></i><span>{item.label}</span></a>)}
  </nav>
  <div class="portal-sidebar-bottom">
    <a href="/" class="portal-menu-link"><i data-lucide="home"></i><span>Inicio</span></a>
    <a href="https://drive.google.com/drive/folders/1LbNvT-mBsiO23nOenrPVRFdJ65aBfKY9" target="_blank" rel="noopener noreferrer" class="portal-menu-link"><i data-lucide="library"></i><span>Biblioteca</span><i data-lucide="external-link" class="portal-external"></i></a>
    <a href="/alumnos/logout/" class="portal-menu-link"><i data-lucide="log-out"></i><span>Cerrar sesión</span></a>
  </div>
</aside>
